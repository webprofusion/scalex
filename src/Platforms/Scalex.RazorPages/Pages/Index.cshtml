@page "{key:regex(^[^.]*$)?}/{scale:regex(^[^.]*$)?}/{tuning:regex(^[^.]*$)?}/{frets:int?}/{mode:regex(^[^.]*$)?}"
@model Scalex.RazorPages.Pages.IndexModel

@using System.Linq
@using Webprofusion.Scalex.Music
@using Webprofusion.Scalex.Util

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

@{
    var currentScaleId = Model.ScaleId;
    var currentModeId = Model.ModeId;
    var currentKey = Model.Key ?? string.Empty;
    var encodedCurrentKey = Uri.EscapeDataString(currentKey);
    var currentTuningId = Model.TuningId;
    var currentFrets = Model.Frets;
    var currentScaleName = Model.Scales.FirstOrDefault(scale => scale.ID == currentScaleId)?.Name ?? string.Empty;
    var currentTuningName = Model.Tunings.FirstOrDefault(tuning => tuning.ID == currentTuningId)?.Name ?? string.Empty;
    var currentModeName = Model.Modes.FirstOrDefault(mode => mode.ID == currentModeId)?.Name ?? string.Empty;
    var currentKeySlug = SlugUtility.CreateSlug(currentKey);
    var currentScaleSlug = SlugUtility.CreateSlug(currentScaleName);
    var currentTuningSlug = SlugUtility.CreateSlug(currentTuningName);
    var currentModeSlug = SlugUtility.CreateSlug(currentModeName);


    ViewData["Title"] = (Model.IsUsingDefaults ? "Guitar Scales " : "Learn the " + Model.DiagramName) + " - Powered by Soundshed";
}

<div class="metal-page">
    <div class="metal-hero">
        <h1>Guitar Scale Diagrams</h1>
        <p>Learn scales the easy way. If you look at any guitar scale pattern you will see that the patterns repeats along the length of the fretboard at the next octave. 
            Fret 0 (the open string), fret 12 and fret 24 start with the same notes, the next octave higher. 
            If you want to change key or mode, you move the same pattern up or down the fretboard in your head. 
            Try viewing E Minor, then F Minor, you'll see that the whole pattern moves up one fret. The "Relative Major" of E Minor is G Major, and you will see they have the exact same layout on the fretboard. The major and natural minor scales share the same notes. 
        
        Click and/or drag to play the scale notes.</p>
       
    </div>


     <a class="branding-banner" href="https://soundshed.com" target="_blank" rel="noopener noreferrer">
            Scalex Guitar Toolkit Powered by <span>Soundshed</span>
        </a>

    <div class="metal-panel">
        <form method="get" class="metal-form">
            <div>
                <label for="scaleId">Scale</label>
                <select id="scaleId" name="scaleId" class="metal-select" onchange="navigateSelection()">
                    @foreach (var scale in Model.Scales)
                    {
                        var scaleSlug = SlugUtility.CreateSlug(scale.Name);
                        <option value="@scaleSlug" selected="@(scaleSlug == currentScaleSlug)">@scale.Name</option>
                    }
                </select>
            </div>

            <div>
                <label for="key">Key</label>
                <select id="key" name="key" class="metal-select" onchange="navigateSelection()">
                    @foreach (var key in Model.Keys)
                    {
                        var keySlug = SlugUtility.CreateSlug(key);
                        <option value="@keySlug" selected="@(keySlug == currentKeySlug)">@key</option>
                    }
                </select>
            </div>

            <div>
                <label for="tuningId">Tuning</label>
                <select id="tuningId" name="tuningId" class="metal-select" onchange="navigateSelection()">
                    @foreach (var tuning in Model.Tunings)
                    {
                        var tuningSlug = SlugUtility.CreateSlug(tuning.Name);
                        <option value="@tuningSlug" selected="@(tuningSlug == currentTuningSlug)">@tuning.Name</option>
                    }
                </select>
            </div>

            <div>
                <label for="frets">Frets</label>
                <select id="frets" name="frets" class="metal-select" onchange="navigateSelection()">
                    @foreach (var fretCount in new[] { 12, 22, 24 })
                    {
                        <option value="@fretCount" selected="@(fretCount == Model.Frets)">@fretCount</option>
                    }
                </select>
            </div>

            @if (Model.Modes.Any())
            {
                <div>
                    <label for="modeId">Mode</label>
                    <select id="modeId" name="modeId" class="metal-select" onchange="navigateSelection()">
                        <option value="">-- None --</option>
                        @foreach (var mode in Model.Modes)
                        {
                            var modeSlug = SlugUtility.CreateSlug(mode.Name);
                            <option value="@modeSlug" selected="@(modeSlug == currentModeSlug)" title="@mode.Character">@mode.Name</option>
                        }
                    </select>
                </div>
            }

            <div>
                <button type="submit" class="metal-button">GO</button>
            </div>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.DiagramUrl))
    {
        <div class="diagram-section metal-panel">
            <h2>@Model.DiagramName</h2>
            @if (!string.IsNullOrWhiteSpace(Model.RelativeScaleInfo))
            {
                <p class="relative-scale">@Model.RelativeScaleInfo</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ModeInfo))
            {
                <p class="mode-info">@Model.ModeInfo</p>
            }
            <div class="play-controls">
                <button type="button" class="metal-button play-btn" data-play="asc">Play Scale ↑</button>
                <button type="button" class="metal-button play-btn" data-play="desc">Play Scale ↓</button>
                <button type="button" class="metal-button play-btn" data-play="updown">Play Scale ↑↓</button>
                <button type="button" class="metal-button play-btn" data-play="melody">Play Melody</button>
            </div>
            <div class="diagram-image-container" data-map-url="@Model.DiagramMapUrl" data-play-url="@Model.PlayDataUrl">
                <img id="diagramImage" src="@Model.DiagramUrl" alt="Scale diagram" class="diagram-image" />
                <div id="diagramHotspots" class="diagram-hotspots"></div>
            </div>

            <div class="link-lists">
                @if (Model.Modes.Any())
                {
                    <div class="link-list">
                        <h2>Modes</h2>
                        <ul>
                            @foreach (var mode in Model.Modes)
                            {
                                <li>
                                    <a class="link-pill @(mode.ID == currentModeId ? "active" : string.Empty)" 
                                       href="@($"/{currentKeySlug}/{currentScaleSlug}/{currentTuningSlug}/{currentFrets}/{SlugUtility.CreateSlug(mode.Name)}")"
                                       title="@mode.Character">@mode.Name</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
                <div class="link-list" style="margin-top:1em;">
                    <h2>Scales and Arpeggios</h2>
                    <ul>
                        @foreach (var scale in Model.Scales)
                        {
                            <li>
                                <a class="link-pill @(scale.ID == currentScaleId ? "active" : string.Empty)" href="@($"/{currentKeySlug}/{SlugUtility.CreateSlug(scale.Name)}/{currentTuningSlug}/{currentFrets}")">@scale.Name</a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="link-list">
                    <h2>Keys</h2>
                    <ul>
                        @foreach (var key in Model.Keys)
                        {
                            <li>
                                <a class="link-pill @(key == currentKey ? "active" : string.Empty)" href="@($"/{SlugUtility.CreateSlug(key)}/{currentScaleSlug}/{currentTuningSlug}/{currentFrets}/{currentModeSlug}")">@key</a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="link-list">
                    <h2>Tunings</h2>
                    <ul>
                        @foreach (var tuning in Model.Tunings)
                        {
                            <li>
                                <a class="link-pill @(tuning.ID == currentTuningId ? "active" : string.Empty)" href="@($"/{currentKeySlug}/{currentScaleSlug}/{SlugUtility.CreateSlug(tuning.Name)}/{currentFrets}/{currentModeSlug}")">@tuning.Name</a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </div>
    }
</div>

<script>
    if (window.self !== window.top) {
        document.body.classList.add("embedded");
    }

    let audioContext;
    let playbackData;
    let diagramMapData;
    let isPointerDownOnMap = false;
    let activeSustainOscillator = null;
    let activeSustainGain = null;
    let activeSustainFrequency = null;

    async function ensureAudioContext() {
        if (!audioContext) {
            audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }

        if (audioContext.state === "suspended") {
            await audioContext.resume();
        }
    }

    async function playFrequency(frequency, durationMs) {
        await ensureAudioContext();

        const now = audioContext.currentTime;
        const duration = durationMs / 1000;
        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();

        oscillator.type = "sine";
        oscillator.frequency.value = frequency;

        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.18, now + 0.01);
        gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

        oscillator.connect(gain);
        gain.connect(audioContext.destination);

        oscillator.start(now);
        oscillator.stop(now + duration + 0.02);
    }

    async function playSequence(sequence) {
        if (!sequence || !sequence.length) {
            return;
        }

        for (const note of sequence) {
            setActiveHotspot(note.markerKey);
            await playFrequency(note.frequency, note.durationMs);
            await new Promise(resolve => setTimeout(resolve, note.durationMs));
        }

        setActiveHotspot(null);
    }

    function setActiveHotspot(markerKey) {
        document.querySelectorAll(".note-hotspot.playing").forEach(el => el.classList.remove("playing"));

        if (!markerKey) {
            return;
        }

        const active = document.querySelector(`.note-hotspot[data-marker-key="${markerKey}"]`);
        if (active) {
            active.classList.add("playing");
        }
    }

    async function startSustainFrequency(frequency) {
        await ensureAudioContext();

        if (activeSustainFrequency === frequency && activeSustainOscillator) {
            return;
        }

        stopSustainFrequency();

        const now = audioContext.currentTime;
        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();

        oscillator.type = "sine";
        oscillator.frequency.value = frequency;

        gain.gain.setValueAtTime(0.0001, now);
        gain.gain.exponentialRampToValueAtTime(0.18, now + 0.01);

        oscillator.connect(gain);
        gain.connect(audioContext.destination);
        oscillator.start(now);

        activeSustainOscillator = oscillator;
        activeSustainGain = gain;
        activeSustainFrequency = frequency;
    }

    function stopSustainFrequency() {
        if (!audioContext || !activeSustainOscillator || !activeSustainGain) {
            activeSustainOscillator = null;
            activeSustainGain = null;
            activeSustainFrequency = null;
            return;
        }

        const now = audioContext.currentTime;
        activeSustainGain.gain.cancelScheduledValues(now);
        activeSustainGain.gain.setValueAtTime(Math.max(activeSustainGain.gain.value, 0.0001), now);
        activeSustainGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.04);
        activeSustainOscillator.stop(now + 0.05);

        activeSustainOscillator = null;
        activeSustainGain = null;
        activeSustainFrequency = null;
    }

    async function loadPlaybackData() {
        if (playbackData) {
            return playbackData;
        }

        const container = document.querySelector(".diagram-image-container");
        if (!container?.dataset.playUrl) {
            return null;
        }

        const response = await fetch(container.dataset.playUrl, { credentials: "same-origin" });
        if (!response.ok) {
            return null;
        }

        playbackData = await response.json();
        return playbackData;
    }

    async function wirePlaybackButtons() {
        const data = await loadPlaybackData();
        if (!data) {
            return;
        }

        document.querySelectorAll(".play-btn").forEach(btn => {
            btn.addEventListener("click", async () => {
                const mode = btn.dataset.play;
                if (mode === "asc") {
                    await playSequence(data.scaleAscending);
                } else if (mode === "desc") {
                    await playSequence(data.scaleDescending);
                } else if (mode === "updown") {
                    await playSequence([...(data.scaleAscending ?? []), ...(data.scaleDescending ?? [])]);
                } else if (mode === "melody") {
                    await playSequence(data.melody);
                }
            });
        });
    }

    function renderDiagramHotspots() {
        const container = document.querySelector(".diagram-image-container");
        const hotspots = document.getElementById("diagramHotspots");
        const image = document.getElementById("diagramImage");

        if (!container || !hotspots || !image || !diagramMapData) {
            return;
        }

        const width = image.clientWidth;
        const height = image.clientHeight;

        hotspots.style.width = `${width}px`;
        hotspots.style.height = `${height}px`;
        hotspots.style.left = `${image.offsetLeft}px`;
        hotspots.style.top = `${image.offsetTop}px`;

        hotspots.innerHTML = "";

        for (const marker of diagramMapData.markers ?? []) {
            const el = document.createElement("button");
            el.type = "button";
            el.className = "note-hotspot";
            el.title = `${marker.noteName} (String ${marker.stringNumber + 1}, Fret ${marker.fretNumber})`;

            const sizePx = Math.max(10, marker.radiusRatio * width * 2);
            el.style.left = `${marker.xRatio * width}px`;
            el.style.top = `${marker.yRatio * height}px`;
            el.style.width = `${sizePx}px`;
            el.style.height = `${sizePx}px`;
            el.dataset.markerKey = `${marker.stringNumber}-${marker.fretNumber}`;

            el.addEventListener("pointerdown", async (event) => {
                event.preventDefault();
                isPointerDownOnMap = true;
                setActiveHotspot(el.dataset.markerKey);
                await startSustainFrequency(marker.frequency);
            });

            el.addEventListener("pointerenter", async () => {
                if (!isPointerDownOnMap) {
                    return;
                }

                setActiveHotspot(el.dataset.markerKey);
                await startSustainFrequency(marker.frequency);
            });

            el.addEventListener("pointerup", () => {
                isPointerDownOnMap = false;
                stopSustainFrequency();
                setActiveHotspot(null);
            });

            el.addEventListener("pointercancel", () => {
                isPointerDownOnMap = false;
                stopSustainFrequency();
                setActiveHotspot(null);
            });

            hotspots.appendChild(el);
        }
    }

    async function loadDiagramMap() {
        const container = document.querySelector(".diagram-image-container");
        const image = document.getElementById("diagramImage");

        if (!container?.dataset.mapUrl || !image) {
            return;
        }

        const response = await fetch(container.dataset.mapUrl, { credentials: "same-origin" });
        if (!response.ok) {
            return;
        }

        diagramMapData = await response.json();

        if (image.complete) {
            renderDiagramHotspots();
        } else {
            image.addEventListener("load", renderDiagramHotspots, { once: true });
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        wirePlaybackButtons();
        loadDiagramMap();
        window.addEventListener("resize", renderDiagramHotspots);
        window.addEventListener("pointerup", () => {
            isPointerDownOnMap = false;
            stopSustainFrequency();
            setActiveHotspot(null);
        });
    });

    function navigateSelection() {
        const key = document.getElementById("key").value;
        const scale = document.getElementById("scaleId").value;
        const tuning = document.getElementById("tuningId").value;
        const frets = document.getElementById("frets").value;
        const modeElement = document.getElementById("modeId");
        const mode = modeElement ? modeElement.value : "";
        let path = `/${key}/${scale}/${tuning}/${frets}`;
        if (mode) {
            path += `/${mode}`;
        }
        window.location.assign(path);
    }
</script>
